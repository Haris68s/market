# ============================================================
#  KONFIGURASI KANTINSISWA
#  Salin file ini menjadi ".env" lalu isi nilainya.
#  JANGAN pernah commit file .env ke git!
#  ============================================================

# --- Aplikasi ---
NODE_ENV=development
PORT=3000
# Alamat website (dipakai untuk membuat tautan produk pada pesan WhatsApp)
APP_URL=http://localhost:3000
# Nama aplikasi (bisa diubah lewat satu variabel ini)
APP_NAME=KantinSiswa
APP_SHORT_NAME=KS
# Kontak bantuan yang ditampilkan di footer
SUPPORT_CONTACT=support@kantinsiswa.local

# --- Database (MongoDB Atlas) ---
# Ganti <username>, <password>, dan <cluster> sesuai akun Atlas Anda.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kantinsiswa
MONGODB_DB_NAME=kantinsiswa

# --- Session ---
# WAJIB diganti! Buat nilai acak dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter-di-sini
SESSION_COOKIE_NAME=ks.sid
# Umur session dalam milidetik (7 hari = 604800000)
SESSION_MAX_AGE_MS=604800000
# 'lax' atau 'strict'. Jangan diubah tanpa alasan yang jelas.
SESSION_SAME_SITE=lax
# Set 'true' saat memakai HTTPS (produksi)
SESSION_SECURE=false

# --- Penyimpanan gambar ---
# Pilihan: cloudinary | local
# cloudinary = produksi (gratis 25 credit/bulan)
# local      = development (file disimpan di public/uploads)
IMAGE_PROVIDER=local

# Cloudinary (diperlukan bila IMAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kantinsiswa

# --- CORS ---
# Kosongkan bila hanya memakai satu domain. Pisahkan dengan koma bila perlu.
CORS_ORIGINS=

# --- Rate limit ---
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=600000
RATE_LIMIT_ORDER_MAX=30
RATE_LIMIT_ORDER_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000

# --- Setup akun super admin (dipakai oleh: npm run create-admin) ---
# Isi sekali, lalu HAPUS dari .env setelah akun dibuat.
BOOTSTRAP_ADMIN_NAME=Admin KantinSiswa
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_WHATSAPP=
BOOTSTRAP_ADMIN_PASSWORD=
