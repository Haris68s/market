{
  "name": "kantinsiswa",
  "version": "1.0.0",
  "description": "Marketplace siswa SMK - platform jualan produk & jasa antar siswa",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=90000 --test-global-setup=./tests/global-setup.js \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "icons": "node scripts/build-icon-sprite.mjs",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "migrate": "node scripts/migrate-to-atlas.js",
    "check-db": "node scripts/check-db.js",
    "setup": "npm run icons && npm run seed",
    "check-secrets": "node scripts/check-secrets.js",
    "pretest": "node scripts/check-secrets.js"
  },
  "keywords": [
    "marketplace",
    "smk",
    "siswa",
    "whatsapp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0",
    "mongoose": "^8.24.6",
    "multer": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "lucide-static": "^1.61.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
